        string RuntimeVersion = "Runtime V0.10.3.0.alpha.7"
        string Version = "Spatial Editor V0.10.2-alpha.3"
    }
    defaultPrim = "Root"
    endTimeCode = 0
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Y"
)

def Xform "Root"
{
    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.04, -0.04, -0.04), (0.04, 0.04, 0.04)]
        rel material:binding = </Root/Sphere/Material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.03999999910593033
        token visibility = "inherited"

        def Material "Material" (
            customData = {
                bool applyToneMapping = 1
                string blendingMode = "TRANSPARENT"
                string materialType = "SHADER_GRAPH"
                float opacityThreshold = 0
                string shaderGraphGuid = "6a57efbe-27fd-4b72-ac2f-d1b284c6283a"
            }
            instanceable = false
        )
        {
            reorder properties = ["outputs:mtlx:surface", "outputs:realitykit:vertex"]
            token outputs:mtlx:surface.connect = </Root/Sphere/Material/PreviewSurface.outputs:out>
            token outputs:realitykit:vertex
            float2 ui:nodegraph:node:pos = (66.13863, 725.2943)
            int ui:nodegraph:node:stackingOrder = 0
            float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (66.13863, 725.2943)
            int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 0

            def Shader "PreviewSurface"
            {
                uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
                float inputs:clearcoat = 1
                float inputs:clearcoatRoughness = 0.01
                color3f inputs:diffuseColor = (1, 1, 1) (
                    colorSpace = "srgb_texture"
                )
                color3f inputs:diffuseColor.connect = None
                color3f inputs:emissiveColor = (0, 0, 0) (
                    colorSpace = "srgb_texture"
                )
                color3f inputs:emissiveColor.connect = None
                float inputs:ior = 1.33
                float inputs:metallic = 0
                float3 inputs:normal = (0, 0, 1)
                float inputs:occlusion = 1
                float inputs:opacity = 1
                float inputs:opacity.connect = None
                float inputs:opacityThreshold = 0
                float inputs:roughness = 0
                int inputs:useSpecularWorkflow = 0
                token outputs:out
                float2 ui:nodegraph:node:pos = (-248.42712, 386.66632)
                int ui:nodegraph:node:stackingOrder = 0
                string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
            }
        }
    }
}

